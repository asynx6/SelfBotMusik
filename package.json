{
    "name": "selfbotmusik",
    "version": "2.0.0",
    "description": "Discord music selfbot with Lavalink + a secure SQLite-backed web dashboard.",
    "main": "index.js",
    "scripts": {
        "start": "node --max-old-space-size=160 index.js",
        "start:plain": "node index.js",
        "dev": "node index.js",
        "test": "node --test test/**/*.test.js",
        "setup:bin": "node scripts/fetch-binaries.js",
        "update:bin": "node scripts/fetch-binaries.js --force",
        "postinstall": "node scripts/fetch-binaries.js --quiet"
    },
    "keywords": [
        "discord",
        "selfbot",
        "lavalink",
        "poru",
        "music",
        "dashboard",
        "sqlite"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@discordjs/voice": "^0.19.2",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^12.11.1",
        "busboy": "^1.6.0",
        "cookie-parser": "^1.4.7",
        "discord.js-selfbot-v13": "^3.7.1",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "music-metadata": "^7.14.0",
        "opusscript": "^0.1.1",
        "poru": "^5.3.0",
        "tweetnacl": "^1.0.3",
        "ws": "^8.21.0"
    }
}
